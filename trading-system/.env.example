# Copy this file to .env and fill in ONLY when switching to live mode.
# Paper trading and backtesting need no keys at all.
#
# Create keys on your exchange with TRADE permission only.
# NEVER enable withdrawal permission on API keys used by a bot.
EXCHANGE_API_KEY=
EXCHANGE_API_SECRET=

# --- MetaTrader 5 (platform: mt5) -----------------------------------
# All optional if the MT5 terminal is already running and logged in.
MT5_LOGIN=
MT5_PASSWORD=
MT5_SERVER=
MT5_TERMINAL_PATH=
